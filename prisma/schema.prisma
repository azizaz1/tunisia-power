generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Vote {
  id         String     @id @default(cuid())
  locationId String
  status     VoteStatus
  ipHash     String
  createdAt  DateTime   @default(now())

  @@index([locationId, createdAt])
  @@index([locationId, ipHash])
}

enum VoteStatus {
  ON
  OFF
}

model PushSubscription {
  id                 String   @id @default(cuid())
  locationId         String
  endpoint           String
  p256dh             String
  auth               String
  lastNotifiedStatus String? // "ON" | "OFF" | "UNKNOWN" | null (never notified)
  createdAt          DateTime @default(now())

  @@unique([endpoint, locationId])
  @@index([locationId])
}
